# Copy to ~/.config/robodojo/g05_vast.env and chmod 600.
HF_TOKEN=
MODELSCOPE_API_TOKEN=
WANDB_API_KEY=
SERVERCHAN_SENDKEY=

HF_DATASET_REPO=larryi/RoboDojo-G05-12task
HF_DATASET_SOURCE_REPO=RoboDojo-Benchmark/GOAI-2026
HF_DATASET_SOURCE_PATH=data/lerobot_v30_joint
HF_OUTPUT_REPO=larryi/G05-RoboDojo-12task
# Default downloads only the official RoboDojo G05 checkpoint from ModelScope.
# After uploading that checkpoint once to HF, use:
# G05_CHECKPOINT_SOURCE=huggingface
# HF_CHECKPOINT_REPO=larryi/<your-g05-checkpoint-repo>
G05_CHECKPOINT_SOURCE=modelscope
# Processor/tokenizer source used by the RoboDojo checkpoint. This repository
# is gated on HF; the HF_TOKEN must have access approved.
HF_G05_BASE_REPO=OpenGalaxea/G05
HF_G05_PROCESSOR_PATH=qwen3_5_2b_base_processor
HF_G05_ACTION_TOKENIZER_PATH=action_tokenizer.pt
G05_GPUS=0
G05_SAVE_INTERVAL_STEPS=5000
G05_KEEP_CHECKPOINTS=1
G05_AUTO_RESUME=1
G05_DATASET_SOURCE=huggingface
G05_TRAIN_TASK=real/g0plus_xpolicylab_finetune
# Pro 6000WS 96GB starting point.
G05_TRAIN_ARGS='model.batch_size=4 model.grad_accumulation_steps=2'
