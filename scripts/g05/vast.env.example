# Copy to ~/.config/robodojo/g05_vast.env and chmod 600.
HF_TOKEN=
MODELSCOPE_API_TOKEN=
WANDB_API_KEY=
SERVERCHAN_SENDKEY=

HF_DATASET_REPO=larryi/RoboDojo-G05-12task
HF_OUTPUT_REPO=larryi/G05-RoboDojo-12task
G05_GPUS=0,1,2,3
G05_SAVE_INTERVAL_STEPS=2000
G05_KEEP_CHECKPOINTS=1
G05_DATASET_SOURCE=modelscope
G05_TRAIN_TASK=real/g0plus_xpolicylab_finetune
# Optional if the external checkout needs custom Hydra overrides:
# G05_TRAIN_ARGS='model.batch_size=1 model.grad_accumulation_steps=8'
